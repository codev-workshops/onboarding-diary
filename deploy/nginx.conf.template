# Serves the SPA and proxies the API under the same origin, so the refresh cookie stays
# first-party and CORS is not involved in production (T-194).

upstream api {
  server ${API_UPSTREAM};
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Hashed assets are immutable; index.html must never be cached or a deploy is invisible.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location = /index.html {
    add_header Cache-Control "no-store";
  }

  location /api/ {
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /health {
    proxy_pass http://api/health;
  }

  # Client-side routing: unknown paths are app routes, not 404s.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
