generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RECRUIT
  MANAGER
  ADMIN
}

enum TaskCategory {
  LEARNING
  SETUP
  MEETING
  PROJECT
  OTHER
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FeedbackType {
  POSITIVE
  SUGGESTION
  CONCERN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(RECRUIT)
  department   String
  startDate    DateTime @map("start_date")
  managerId    String?  @map("manager_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  manager  User?  @relation("ManagerRecruits", fields: [managerId], references: [id])
  recruits User[] @relation("ManagerRecruits")

  tasks    Task[]
  issues   Issue[]
  feedback Feedback[]
  notes    Note[]

  @@map("users")
}

model Task {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  date        DateTime
  title       String
  description String?
  category    TaskCategory
  status      TaskStatus   @default(NOT_STARTED)
  priority    TaskPriority @default(MEDIUM)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("tasks")
}

model Issue {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  date            DateTime
  title           String
  description     String
  severity        IssueSeverity
  status          IssueStatus   @default(OPEN)
  resolutionNotes String?       @map("resolution_notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("issues")
}

model Feedback {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  date      DateTime
  subject   String
  type      FeedbackType
  details   String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("feedback")
}

model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime
  title     String
  content   String
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
