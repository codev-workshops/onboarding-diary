{
  "name": "@onboarding-diary/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate && prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:push": "prisma db push",
    "postinstall": "npm run prisma:generate",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "csv-stringify": "6.5.0",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "pdfkit": "0.15.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.13.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.15",
    "@types/pdfkit": "0.13.4",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "^2.0.5",
    "prisma": "5.18.0",
    "supertest": "7.0.0",
    "testcontainers": "10.13.0",
    "tsx": "4.17.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
