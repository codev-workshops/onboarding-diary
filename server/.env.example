# Server configuration

# Demo (SQLite) datasource — used in demo mode and as the fallback when no
# production database is configured.
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) datasource — set this when configuring a production DB.
# When DEMO_MODE=false and this is set, the app uses PostgreSQL.
DATABASE_URL_POSTGRES=""

# Demo-mode feature flag (see docs/ASSUMPTIONS.md §13).
# true  -> demo DB + onboarding enablers on
# false -> production DB if configured (else demo DB), enablers off
DEMO_MODE="true"

# Auth
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="8h"

# Server
PORT="4000"
CORS_ORIGIN="http://localhost:5173"
