# Server configuration

# Mode is derived from a single variable, DB_STRING (docs/ASSUMPTIONS.md §13):
#   - DB_STRING absent  -> demo mode: SQLite + onboarding enablers + demo accounts
#   - DB_STRING present  -> production mode: PostgreSQL, enablers off, no demo data
#
# DB_STRING is the production PostgreSQL connection string. Leave it UNSET for
# demo. Set it (here on-prem, or via your platform's environment on cloud) only
# after running the one-off setup tool to provision the database. The setup tool
# writes this value here for you on-prem.
# DB_STRING="postgresql://user:password@host:5432/onboarding"

# Demo-mode SQLite datasource (used only when DB_STRING is absent).
DATABASE_URL="file:./dev.db"

# Auth. In production (DB_STRING set) the server refuses to start unless this is a
# strong value (>= 16 chars, not the placeholder). The setup tool generates one.
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="8h"

# Server
PORT="4000"
CORS_ORIGIN="http://localhost:5173"
