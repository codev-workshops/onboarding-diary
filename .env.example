# Copy to .env and adjust. Never commit a populated .env (S13).

# Postgres connection used by Prisma and the app.
DATABASE_URL="postgresql://onboarding:onboarding@localhost:5432/onboarding_diary?schema=public"

# Credentials for the docker compose `db` service.
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=onboarding
POSTGRES_DB=onboarding_diary
POSTGRES_PORT=5432
APP_PORT=3000

# Session signing key — used from M2 onwards. Generate with: openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-secret-change-me-0123456789"

# Optional: overrides the demo password used by prisma/seed.ts.
# SEED_PASSWORD="Passw0rd!23"
