# Copy to .env for local development (never commit .env).
APP_CONFIG=development          # development | testing | production
# REQUIRED in production (>= 32 chars). Generate one; never reuse an example value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///onboarding.db   # optional; defaults to instance/onboarding.db
