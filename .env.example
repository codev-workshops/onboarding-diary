# Copy to .env and adjust as needed. See docs/TRD.md section 9.

# --- PostgreSQL (used by the compose `postgres` service) ---
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=onboarding
POSTGRES_DB=onboarding_diary
POSTGRES_PORT=5432

# --- API ---
# Host-side tooling (prisma migrate, tests) talks to localhost; Compose overrides the
# host with the `postgres` service name inside the network.
DATABASE_URL=postgresql://onboarding:onboarding@localhost:5432/onboarding_diary?schema=public
TEST_DATABASE_URL=postgresql://onboarding:onboarding@localhost:5432/onboarding_diary_test?schema=public
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
WEB_ORIGIN=http://localhost:5173
PORT=4000
LOG_LEVEL=info

# --- Web ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000/api/v1
