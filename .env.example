# Copy to .env and adjust for your machine. Never commit the real .env.
POSTGRES_DB=onboarding_diary
POSTGRES_USER=diary
POSTGRES_PASSWORD=diary
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/onboarding_diary
DB_USERNAME=diary
DB_PASSWORD=diary

SERVER_PORT=8080
# Seed demo accounts on an empty database (disable in production).
DEMO_DATA_ENABLED=true
DEMO_PASSWORD=Password123!
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
