# Copy to .env and fill in real values: cp .env.example .env
# docker compose reads this file automatically; export the vars before ./mvnw spring-boot:run.

# --- Database (Docker Compose service `db`) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onboarding_diary
DB_USER=onboarding_diary
DB_PASSWORD=change-me

# --- Auth ---
# At least 32 characters; a random secret is generated (and tokens die on restart) if unset.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime as an ISO-8601 duration; defaults to 8 hours.
JWT_EXPIRY=PT8H
# Set to true when serving over HTTPS so the token cookie is Secure.
JWT_COOKIE_SECURE=false

# --- First Admin bootstrap (US-A00 / decision D1) ---
# ADMIN_EMAIL and ADMIN_PASSWORD are required to create the first Admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Optional, defaults shown.
ADMIN_NAME=Administrator
ADMIN_DEPARTMENT=Other
ADMIN_START_DATE=2026-01-01

# --- Application ---
SERVER_PORT=8080
