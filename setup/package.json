{
  "name": "@onboarding-diary/setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-off production setup tool. Run in demo mode only to perform the demo→production cutover; never deployed alongside the running app.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.13.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.14.15",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "testcontainers": "10.13.0",
    "tsx": "4.17.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
