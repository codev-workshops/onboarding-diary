# Setup tool configuration.
#
# Run this one-off tool ONLY during the demo→production cutover, and ONLY in a
# demo environment. It refuses to start if DB_STRING is set (i.e. the environment
# is already in production). The target Postgres connection string is supplied
# interactively in the request, never via env.

# Port the setup tool listens on (default 4100).
SETUP_PORT="4100"
