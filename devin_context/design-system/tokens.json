{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Onboarding Diary Design Tokens",
    "source": "UI Design Daily — Day 805 (Style Guide: Button, Dropdown, Input)",
    "sourceUrl": "https://www.uidesigndaily.com/posts/sketch-style-guide-button-dropdown-input-day-805"
  },
  "color": {
    "shape": {
      "primary": "#3457DC",
      "primaryHover": "#2D4DC8",
      "primaryLight": "#869FFD",
      "surfaceMuted": "#F7F9FD",
      "borderSpecial": "#DCDFF1",
      "surface": "#FFFFFF"
    },
    "text": {
      "heading": "#202842",
      "body": "#202842",
      "muted": "#5D698D",
      "link": "#3457DC",
      "onPrimaryMuted": "#687DCF",
      "danger": "#EA4D67",
      "disabled": "#DCDFF1",
      "onPrimary": "#FFFFFF"
    },
    "feedback": {
      "error": "#EA4D67",
      "errorHover": "#E63F5B"
    }
  },
  "typography": {
    "fontFamily": {
      "base": "'Open Sans', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "scale": {
      "lg": { "fontSize": "20px", "weights": [400, 700], "usage": "Section headings" },
      "md": { "fontSize": "16px", "weights": [400, 600, 700], "usage": "Body copy, button labels" },
      "sm": { "fontSize": "14px", "weights": [400, 600], "usage": "Secondary copy, small controls" },
      "xs": { "fontSize": "12px", "weights": [400], "usage": "Helper and validation text" },
      "overline": {
        "fontSize": "10px",
        "weights": [600],
        "textTransform": "uppercase",
        "letterSpacing": "0.06em",
        "usage": "Group labels above controls"
      }
    }
  },
  "radius": {
    "sm": "3px",
    "md": "4px",
    "pill": "9999px"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px"
  },
  "border": {
    "width": "1px",
    "color": "#DCDFF1",
    "colorFocus": "#3457DC",
    "colorError": "#EA4D67"
  },
  "shadow": {
    "hover": "0 6px 14px rgba(52, 87, 220, 0.24)",
    "danger": "0 6px 14px rgba(234, 77, 103, 0.24)",
    "panel": "0 8px 24px rgba(32, 40, 66, 0.10)"
  },
  "motion": {
    "duration": "150ms",
    "easing": "ease-in-out"
  }
}
