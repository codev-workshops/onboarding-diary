# Copy this file to backend/.env and fill in real credentials.
# Never commit backend/.env; it is ignored by git.

# Switch between the persistent Postgres store and the in-memory SQLite store.
# on  -> use Postgres (DATABASE_URL required); falls back to SQLite if the
#        database is unreachable so the application keeps working.
# off -> use the in-memory SQLite store (default).
PERSISTENT_STORE=off

# Postgres connection string used when PERSISTENT_STORE is on.
DATABASE_URL=postgresql://onboarding:change-me@localhost:5432/onboarding_diary
