{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=OnboardingDiary;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "OnboardingDiary",
    "Audience": "OnboardingDiary",
    "SigningKey": "REPLACE_WITH_SECRET_FROM_VAULT_OR_ENV_VAR_IN_PRODUCTION",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "PermitPerMinute": 100,
    "LoginPermit": 5,
    "LoginWindowMinutes": 15
  }
}
