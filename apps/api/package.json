{
  "name": "@onboarding-diary/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -b",
    "clean": "rm -rf dist coverage src/generated *.tsbuildinfo",
    "codegen": "npm run build --workspace @onboarding-diary/shared && prisma generate",
    "predev": "npm run codegen",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "preseed": "npm run codegen",
    "seed": "prisma db seed",
    "pretest": "npm run codegen",
    "pretypecheck": "npm run codegen",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "pretest:coverage": "npm run codegen",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@onboarding-diary/shared": "*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "0.45.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pdfkit": "0.19.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "pdf-parse": "2.4.5",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1"
  }
}
